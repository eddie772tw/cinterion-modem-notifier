# Local-only configuration. Never commit a populated copy of this file.
# Keep blank to run without external notifications.
DISCORD_WEBHOOK_URL=
MODEM_ID=0
POLL_INTERVAL_SECONDS=20
# Incoming SMS notifications include the complete sender number and text.
# Incoming voice calls are not bridged into Discord. Observe is the safe
# starter policy; hangup-incoming is available for a controlled deployment.
CALL_POLICY=observe
LOG_LEVEL=INFO
